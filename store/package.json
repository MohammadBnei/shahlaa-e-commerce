{
  "name": "medusa-server",
  "version": "0.2.0",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "build:admin": "medusa build --admin-only",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "migrate": "medusa db:migrate",
    "start": "medusa start",
    "dev": "medusa develop",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.3.0",
    "@medusajs/cli": "2.3.0",
    "@medusajs/framework": "^2.3.0",
    "@medusajs/medusa": "2.3.0",
    "@mikro-orm/core": "5.9.8",
    "@mikro-orm/knex": "5.9.8",
    "@mikro-orm/migrations": "5.9.8",
    "@mikro-orm/postgresql": "5.9.8",
    "awilix": "^8.0.1",
    "email-templates": "^12.0.1",
    "medusa-plugin-smtp": "^1.2.0",
    "pg": "^8.13.1",
    "preview-email": "^3.1.0",
    "pug": "^3.0.3",
    "react-dropzone": "^14.3.5"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.3.0",
    "@mikro-orm/cli": "5.9.8",
    "@swc/core": "1.10.7",
    "@swc/jest": "^0.2.37",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.14",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=20"
  }
}