{
  "name": "shahlaa-store",
  "version": "0.0.9",
  "description": "The store of shahlaa. Medusa Backend and Admin.",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "cross-env npm run clean && npm run build:server && npm run build:admin",
    "build:server": "medusa build",
    "build:admin": "medusa-admin build --deployment",
    "watch": "cross-env tsc --watch",
    "test": "cross-env jest",
    "seed": "cross-env medusa seed -f ./data/seed.json",
    "start": "medusa db:migrate && medusa start",
    "start:custom": "cross-env npm run build && node --preserve-symlinks --trace-warnings index.js",
    "dev": "cross-env npm run build:server && medusa develop",
    "migrations": "medusa migrations run"
  },
  "dependencies": {
    "@medusajs/admin": "^7.1.17",
    "@medusajs/cache-inmemory": "2.0.7",
    "@medusajs/cache-redis": "^2.0.7",
    "@medusajs/event-bus-local": "2.0.7",
    "@medusajs/event-bus-redis": "^2.0.7",
    "@medusajs/file-local": "2.0.7",
    "@medusajs/medusa": "^2.0.7",
    "@medusajs/types": "^2.0.7",
    "@tanstack/react-query": "5.62.0",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "16.4.5",
    "express": "^4.21.1",
    "medusa-fulfillment-manual": "1.1.41",
    "medusa-interfaces": "1.3.10",
    "medusa-payment-manual": "1.0.25",
    "medusa-payment-stripe": "^6.0.11",
    "prism-react-renderer": "^2.4.0",
    "typeorm": "0.3.20"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.9",
    "@babel/core": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@medusajs/medusa-cli": "1.3.23",
    "@stdlib/number-float64-base-normalize": "0.2.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/mime": "4.0.0",
    "@types/node": "^22.10.1",
    "babel-preset-medusa-package": "^1.1.19",
    "cross-env": "^7.0.3",
    "eslint": "^9.16.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.7.2"
  },
  "jest": {
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.spec.json"
      }
    },
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/node_modules/"
    ],
    "rootDir": "src",
    "testRegex": "(/__tests__/.*|\\.(test|spec))\\.(ts|js)$",
    "transform": {
      ".ts": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  },
  "resolutions": {
    "glob": "^7.1.6"
  }
}